{
  "name": "Image Viewer",
  "short_name": "ImageViewer",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",

  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/jpeg": [".jpg"],
        "image/png": [".png"]
      }
    }
  ],

  "launch_handler": {
    "client_mode": "navigate-existing"
  },

  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
